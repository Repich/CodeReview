# Copy to .env and replace every placeholder. Generate secrets with:
# openssl rand -hex 32
CODEREVIEW_DATABASE_URL=postgresql+psycopg://<DB_USER>:<URL_ENCODED_DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
CODEREVIEW_AUTH_JWT_SECRET=<GENERATE_RANDOM_64_HEX_CHARS>
CODEREVIEW_WORKER_API_TOKEN=<GENERATE_RANDOM_64_HEX_CHARS>
CODEREVIEW_BACKEND_BIND_ADDRESS=127.0.0.1
CODEREVIEW_TRUSTED_PROXY_CIDRS=[]

DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_API_KEY=your-openai-api-key
# Legacy alias is also supported by code:
OPENAI_APIKEY=your-openai-api-key

# Backend feature flags
CODEREVIEW_MODEL_LAB_ENABLED=false
CODEREVIEW_MODEL_LAB_DEFAULT_SAMPLE_SIZE=10
CODEREVIEW_MODEL_LAB_MAX_SAMPLE_SIZE=20
CODEREVIEW_MODEL_LAB_MAX_MODELS=12
CODEREVIEW_MODEL_LAB_MAX_PAID_TARGET_MODELS=2
CODEREVIEW_MODEL_LAB_MAX_PAID_TARGET_RUNS=40
CODEREVIEW_MODEL_LAB_MAX_EXPERT_MODELS=2
CODEREVIEW_MODEL_LAB_MAX_EXPERT_CALLS=120
